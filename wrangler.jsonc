{
	// Cloudflare Worker 설정 — wrangler(배포·로컬 개발·D1 명령)와 Astro Cloudflare 어댑터가 함께 읽는다.
	// main(서버 진입점)·assets(정적 파일)는 @astrojs/cloudflare 가 빌드할 때 자동으로 채운다.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "modu-in",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// 로그 보기 (Cloudflare 대시보드 → Workers → modu-in → Logs)
	"observability": {
		"enabled": true
	},
	// 실행 지역 고정 — Cloudflare 가 사용자 근처 서버(예: 홍콩)에서 실행하면 Gemini 가 "지원하지 않는 지역"으로 거부한다.
	// 서울(Gemini 지원 지역, 한국 사용자·D1 과도 가까움)에서 실행되도록 지정
	"placement": {
		"mode": "targeted",
		"region": "gcp:asia-northeast3"
	},
	// D1 데이터베이스. 코드에서는 env.DB 로 쓴다.
	//  1) npx wrangler d1 create modu-db
	//  2) 출력된 database_id 를 아래에 붙여 넣기 (로컬 개발은 이 값과 상관없이 동작)
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "modu-db",
			"database_id": "3b19df21-9094-413e-bdab-dff2a960938a"
		}
	]
	// GEMINI_API_KEY 는 여기에 적지 않는다(비밀값).
	//  배포: npx wrangler secret put GEMINI_API_KEY
	//  로컬: .dev.vars 파일
	// GEMINI_MODEL 을 바꾸려면(기본 gemini-3.8-flash): "vars": { "GEMINI_MODEL": "모델 이름" }
}