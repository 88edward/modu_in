---
interface Props {
  size?: 'md' | 'sm';
}
const { size = 'md' } = Astro.props;
---

<a href="/" class:list={['logo', size]} aria-label="모두의 인증 홈">
  <svg viewBox="0 0 32 32" aria-hidden="true">
    <path d="M3 27V5h5.5l5.5 8.5L19.5 5H21v22h-5.5V15.5l-4 6h-2l-4-6V27z" fill="#8a94a6"></path>
    <rect x="23.5" y="5" width="5.5" height="14" rx="1.2" fill="#0b2a6b"></rect>
    <rect x="23.5" y="21.5" width="5.5" height="5.5" rx="1.2" fill="#0b2a6b"></rect>
  </svg>
  <span>모두의 인증</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #0b2a6b;
    font-weight: 800;
    letter-spacing: -0.04em;
    flex-shrink: 0;
  }
  .logo.md svg {
    width: 30px;
    height: 30px;
  }
  .logo.md span {
    font-size: 24px;
  }
  .logo.sm svg {
    width: 16px;
    height: 16px;
  }
  .logo.sm span {
    font-size: 12px;
  }
</style>
